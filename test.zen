import (Stack) from "lib.zen"

Stack s

screen(s.isEmptyInt())
screen(s.sizeInt())

s.pushInt(10)
s.pushInt(20)
s.pushInt(30)

screen(s.isEmptyInt())
screen(s.sizeInt())
screen(s.peekInt())

screen(s.popInt())
screen(s.popInt())

screen(s.peekInt())
screen(s.sizeInt())

s.pushBool(true)
s.pushBool(false)

screen(s.isEmptyBool())
screen(s.sizeBool())
screen(s.peekBool())
screen(s.popBool())
screen(s.popBool())
screen(s.isEmptyBool())

s.pushDouble(3.14)
s.pushDouble(6.28)

screen(s.sizeDouble())
screen(s.peekDouble())
screen(s.popDouble())
screen(s.popDouble())
screen(s.isEmptyDouble())

s.pushLong(100L)
s.pushLong(200L)

screen(s.sizeLong())
screen(s.peekLong())
screen(s.popLong())
screen(s.popLong())
screen(s.isEmptyLong())

s.pushByte(10B)
s.pushByte(20B)

screen(s.sizeByte())
screen(s.peekByte())
screen(s.popByte())
screen(s.popByte())
screen(s.isEmptyByte())

s.pushString("hello")
s.pushString("world")

screen(s.sizeString())
screen(s.peekString())
screen(s.popString())
screen(s.popString())
screen(s.isEmptyString())
